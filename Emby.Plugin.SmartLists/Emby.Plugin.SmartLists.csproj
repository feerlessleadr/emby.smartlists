<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Emby Server 4.10.1.0 runs plugins on net8.0. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Emby.Plugin.SmartLists</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1873</NoWarn>
    <Nullable>enable</Nullable>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- Version will be set dynamically during build from git tag -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Version).0</AssemblyVersion>
    <PackageIcon>logo.jpg</PackageIcon>
    <!-- Point EmbySystemDir at the "system" folder of an Emby Server 4.10.1.0 install (or set EMBY_SYSTEM_DIR). -->
    <EmbySystemDir Condition="'$(EmbySystemDir)' == ''">$(EMBY_SYSTEM_DIR)</EmbySystemDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\images\logo.jpg" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Exposes internal members (e.g. Engine's internal statics) to the test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Emby.Plugin.SmartLists.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\config.html" />
    <!-- User-facing pages -->
    <EmbeddedResource Include="Configuration\user-playlists.html" />
    <!-- Core utilities and constants (must load first) -->
    <EmbeddedResource Include="Configuration\config-controller.js" />
    <EmbeddedResource Include="Configuration\config-core.js" />
    <!-- Formatters and option generators -->
    <EmbeddedResource Include="Configuration\config-formatters.js" />
    <!-- Schedule management -->
    <EmbeddedResource Include="Configuration\config-schedules.js" />
    <!-- Image management -->
    <EmbeddedResource Include="Configuration\config-images.js" />
    <!-- Sort management -->
    <EmbeddedResource Include="Configuration\config-sorts.js" />
    <!-- Generic multi-select component -->
    <EmbeddedResource Include="Configuration\config-multi-select.js" />
    <!-- Multi-select component CSS -->
    <EmbeddedResource Include="Configuration\config-multi-select.css" />
    <!-- Searchable single-select component -->
    <EmbeddedResource Include="Configuration\config-searchable-select.js" />
    <!-- User selection component -->
    <EmbeddedResource Include="Configuration\config-user-select.js" />
    <!-- Rule management -->
    <EmbeddedResource Include="Configuration\config-rules.js" />
    <!-- Playlist CRUD operations -->
    <EmbeddedResource Include="Configuration\config-lists.js" />
    <!-- Template catalog and picker -->
    <EmbeddedResource Include="Configuration\config-templates.js" />
    <!-- Filtering and search -->
    <EmbeddedResource Include="Configuration\config-filters.js" />
    <!-- Bulk actions -->
    <EmbeddedResource Include="Configuration\config-bulk-actions.js" />
    <!-- Status page -->
    <EmbeddedResource Include="Configuration\config-status.js" />
    <!-- API calls -->
    <EmbeddedResource Include="Configuration\config-api.js" />
    <!-- Initialization (must load last) -->
    <EmbeddedResource Include="Configuration\config-init.js" />
    <!-- Smart list badge overlay for cover images -->
    <EmbeddedResource Include="Resources\badge.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Common"><HintPath>$(EmbySystemDir)\MediaBrowser.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Controller"><HintPath>$(EmbySystemDir)\MediaBrowser.Controller.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Model"><HintPath>$(EmbySystemDir)\MediaBrowser.Model.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Emby ships Microsoft.Extensions.* / ASP.NET Core 8.0 itself; compile against the targeting pack only. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The end-user page and its endpoints are outside the Emby MVP (admin page only). -->
  <ItemGroup>
    <Compile Remove="Api\Controllers\UserPagesController.cs" />
    <Compile Remove="Api\Controllers\UserSmartListController.cs" />
  </ItemGroup>

  <!--
    ImageSharp is not shipped by Emby, so it is embedded in the plugin DLL as a resource and loaded from memory by
    Plugin.cs when first needed. A loose SixLabors.ImageSharp.dll in the plugins folder would be file-locked by the
    running server (breaking in-place upgrades, e.g. by a GitHub plugin installer) and could clash with another
    plugin that ships its own copy. The runtime asset is excluded so it is not copied next to the plugin.
  -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" GeneratePathProperty="true">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <EmbeddedResource Include="$(PkgSixLabors_ImageSharp)\lib\net6.0\SixLabors.ImageSharp.dll" LogicalName="SixLabors.ImageSharp.dll" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

</Project>
